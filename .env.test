# 已入库测试夹具（非 secret，fastapi 仓先例）：pytest / mypy 静态检查进程消费。
# 与 .env.example 键集一致（L0.5 env 门）。DATABASE_URL 不触真库——测试用 pytest.mark.django_db 建事务回滚。
DJANGO_SECRET_KEY=django-insecure-skeleton-test-key-0123456789abcdef
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54321/lab_test

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY) ——
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-django
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# —— saas OAuth (直连 saas IdP, ADR-0009; 恒真链；T2 auth 域起消费) ——
LAB_SAAS_BASE_URL=http://localhost:5101
LAB_SSO_LOGIN_URL=http://localhost:5101
LAB_SAAS_CLIENT_ID=lab-management
LAB_SAAS_CLIENT_SECRET=lab-management-secret
LAB_SAAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LAB_SSO_CALLBACK_REDIRECT=http://localhost:5213/login
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=dev123456
LAB_SAAS_SERVICE_CLIENT_ID=lab-management

# —— CORS allowed origins (SSO 跨域用; 勿写成 saas 家族的 SAAS_CORS_*) ——
LAB_CORS_ALLOWED_ORIGINS=http://localhost:5201,http://localhost:5202,http://localhost:5203,http://localhost:5101,http://localhost:5208,http://localhost:5213
